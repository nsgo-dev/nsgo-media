end

design message name="Sign in · Message only" device=desktop width=400 height=260 class="overflow-hidden rounded-2xl bg-white"
box class="flex-1" note="A prompt without a code: the plugin opened its page in the browser and waits."
  box class="flex-1 items-center gap-4 px-6 pt-7 pb-5"
    box class="size-12 items-center justify-center rounded-2xl bg-[#FF6B4A]/10"
      icon globe class="size-6 text-[#E8553A]"
    end
    text "Sign in to Demo" class="text-[17px] font-bold text-zinc-900"
    text "Finish signing in in your browser, then come back." class="max-w-[300px] text-center text-[13px] leading-relaxed text-zinc-600"
  end
  use dialog-actions confirm.class="hidden" cancel.tap="close"
end
