component name="Sidebar/Plugin heading" width=fill preview=216 backdrop="bg-zinc-100/90"
box class="mt-4 h-6 flex-row items-center gap-2 px-2.5"
  text "Demo" name=title class="flex-1 truncate text-[11px] font-semibold text-zinc-400"
  box name=account class="size-5 items-center justify-center rounded-full bg-zinc-200/80" note="The plugin's account: its avatar when signed in, which opens a menu with Sign Out; a sign-in arrow when it has signIn and nobody is signed in; absent without account exports."
    image "Signed-in viewer's avatar" name=avatar src="assets/thumbs/avatar1.jpg" class="size-5 rounded-full"
    icon log-in name=sign-in class="hidden size-3 text-zinc-500"
  end
end
variant signed-out avatar.class="hidden" sign-in.class="flex"
variant no-account account.class="hidden"
