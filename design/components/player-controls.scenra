component name="Player/Controls" width=fill preview=800 backdrop="bg-linear-to-br from-sky-700 via-amber-600 to-rose-800"
box class="gap-3 overflow-hidden rounded-[28px] border border-white/25 bg-white/10 px-4 pt-3 pb-4 shadow-2xl backdrop-blur-2xl backdrop-saturate-150" note="A floating panel of Liquid Glass over the picture, 800 points wide, centred near the window's bottom: it blurs and brightens the video behind it, with a light rim along its top. It shows and hides with the top bar."
  box class="absolute top-0 right-0 left-0 h-12 bg-linear-to-b from-white/20 to-transparent"
  end
  box class="flex-row items-center gap-2"
    box class="flex-row items-center gap-0.5 rounded-full bg-white/10 p-1"
      box name=play class="size-10 items-center justify-center rounded-full bg-white/90 shadow-md hover:bg-white"
        icon pause name=play-icon class="size-5 text-zinc-900"
      end
      box name=next class="size-10 items-center justify-center rounded-full hover:bg-white/15" note="Plays the next part; shown for a video of several parts."
        icon skip-forward class="size-[18px] text-white"
      end
    end
    box name=volume class="h-12 flex-row items-center gap-2 rounded-full bg-white/10 pr-4 pl-1"
      box class="size-10 items-center justify-center rounded-full hover:bg-white/15"
        icon volume-2 name=volume-icon class="size-[18px] text-white"
      end
      box class="h-1 w-20 rounded-full bg-white/25"
        box class="h-full w-3/4 rounded-full bg-white"
        end
      end
    end
    box class="flex-1 items-center gap-0.5 px-4"
      text "The ridge catches the sun" name=caption class="truncate text-[13px] font-semibold text-white"
      text "P2 · Sunrise over an alpine lake" name=subcaption class="truncate text-[11px] font-medium text-white/60"
    end
    box class="flex-row items-center gap-0.5 rounded-full bg-white/10 p-1"
      box name=parts class="h-10 flex-row items-center gap-1.5 rounded-full px-3 hover:bg-white/15" note="The parts of the video; shown when it has several."
        icon list-video class="size-[18px] text-white"
        text "P2/3" name=parts-label class="text-[13px] font-medium text-white"
      end
      box name=speed class="h-10 min-w-10 items-center justify-center rounded-full px-2.5 hover:bg-white/15"
        text "1×" name=speed-label class="text-[13px] font-semibold text-white"
      end
      box name=subtitles class="size-10 items-center justify-center rounded-full hover:bg-white/15" note="Subtitle and audio tracks, in one menu; shown when the source has a choice."
        icon captions class="size-5 text-white"
      end
      box name=quality class="h-10 items-center justify-center rounded-full px-3 hover:bg-white/15" note="The qualities the plugin's stream offers; shown when it offers several."
        text "1080p" name=quality-label class="text-[13px] font-semibold text-white"
      end
      box name=fullscreen class="size-10 items-center justify-center rounded-full hover:bg-white/15"
        icon maximize name=fullscreen-icon class="size-[18px] text-white"
      end
    end
  end
  box class="flex-row items-center gap-3 px-1"
    text "1:31:05" name=elapsed class="w-14 text-[12px] font-medium text-white/90"
    box name=seek class="h-4 flex-1 justify-center" note="Seeks where pressed or dragged, showing the time under the pointer; the lighter range is what is buffered. The bar thickens while the pointer is over it."
      box class="h-1.5 overflow-hidden rounded-full bg-white/20"
        box class="absolute top-0 bottom-0 left-0 w-[72%] bg-white/30"
        end
        box name=played class="absolute top-0 bottom-0 left-0 w-[56%] rounded-full bg-white"
        end
      end
      box name=thumb class="absolute left-[56%] -ml-2 size-4 rounded-full bg-white shadow-lg"
      end
    end
    text "−15:27" name=remaining class="w-14 text-right text-[12px] font-medium text-white/60" note="The time left; pressing it shows the duration instead."
  end
end
variant local parts.class="hidden" next.class="hidden" quality.class="hidden" subcaption.class="hidden"
variant fullscreen fullscreen-icon=minimize
