component name="Player/Controls" width=fill preview=560 backdrop="bg-linear-to-br from-sky-700 via-amber-600 to-rose-800"
box class="gap-1 overflow-hidden rounded-2xl border border-white/20 bg-black/40 px-2 pt-2 pb-1.5 shadow-xl backdrop-blur-2xl backdrop-saturate-150" note="Slim floating Liquid Glass bar: a thin seek line over one row of small buttons. Shows only while the pointer is over the player window and fades out with the top bar, as the Player window's note says; it stays while the pointer is over it or one of its menus is open."
  box name=seek class="h-2.5 justify-center px-1" note="Seeks where pressed or dragged, showing the time under the pointer; the line thickens to 4 points under the pointer, and the lighter range is what is buffered."
    box class="h-[3px] overflow-hidden rounded-full bg-white/20"
      box class="absolute top-0 bottom-0 left-0 w-[72%] bg-white/30"
      end
      box name=played class="absolute top-0 bottom-0 left-0 w-[56%] rounded-full bg-white"
      end
    end
    box name=thumb class="absolute left-[56%] -ml-1 size-2.5 rounded-full bg-white shadow-md"
    end
  end
  box class="h-7 flex-row items-center gap-0.5"
    box name=play class="size-7 items-center justify-center rounded-full hover:bg-white/15"
      icon pause name=play-icon class="size-4 text-white"
    end
    box name=next class="size-7 items-center justify-center rounded-full hover:bg-white/15" note="Plays the next part; shown for a video of several parts."
      icon skip-forward class="size-3.5 text-white"
    end
    box name=volume class="h-7 flex-row items-center gap-1 rounded-full pr-2 hover:bg-white/10"
      box class="size-7 items-center justify-center"
        icon volume-2 name=volume-icon class="size-3.5 text-white"
      end
      box name=volume-slider class="h-[3px] w-12 rounded-full bg-white/25" note="Shown while the pointer is over the volume button."
        box class="h-full w-3/4 rounded-full bg-white"
        end
      end
    end
    box name=time class="flex-row items-center gap-1 px-1.5" note="Pressing it switches the duration to the time left."
      text "1:31:05" name=elapsed class="text-[11px] font-medium text-white/90"
      text "/" class="text-[11px] text-white/40"
      text "1:46:32" name=duration class="text-[11px] font-medium text-white/50"
    end
    box class="flex-1"
    end
    box name=danmaku class="h-7 flex-row items-center gap-1 rounded-full px-2 hover:bg-white/15" note="Toggles danmaku; pressing and holding, or the arrow beside it on hover, opens danmaku settings."
      icon message-square-text name=danmaku-icon class="size-3.5 text-[#66CCFF]"
      text "DM" name=danmaku-label class="text-[11px] font-semibold text-white"
      box name=danmaku-dot class="size-1 rounded-full bg-[#66CCFF]"
      end
    end
    box name=parts class="h-7 flex-row items-center gap-1 rounded-full px-2 hover:bg-white/15" note="The parts of the video; shown when it has several."
      icon list-video class="size-3.5 text-white"
      text "P2/3" name=parts-label class="text-[11px] font-medium text-white"
    end
    box name=speed class="h-7 min-w-7 items-center justify-center rounded-full px-1.5 hover:bg-white/15"
      text "1×" name=speed-label class="text-[11px] font-semibold text-white"
    end
    box name=subtitles class="size-7 items-center justify-center rounded-full hover:bg-white/15" note="Subtitle and audio tracks, in one menu; shown when the source has a choice."
      icon captions class="size-3.5 text-white"
    end
    box name=quality class="h-7 items-center justify-center rounded-full px-2 hover:bg-white/15" note="The qualities the plugin's stream offers; shown when it offers several."
      text "1080p" name=quality-label class="text-[11px] font-semibold text-white"
    end
    box name=fullscreen class="size-7 items-center justify-center rounded-full hover:bg-white/15"
      icon maximize name=fullscreen-icon class="size-3.5 text-white"
    end
  end
end
variant local parts.class="hidden" next.class="hidden" quality.class="hidden" danmaku.class="hidden"
variant fullscreen fullscreen-icon=minimize
variant danmaku-off danmaku-icon.class="text-white/50" danmaku-label.class="text-white/60" danmaku-dot.class="hidden"
variant mini volume-slider.class="hidden" volume.class="pr-0" parts.class="hidden" speed.class="hidden" subtitles.class="hidden" quality.class="hidden" next.class="hidden"
