component name="Navigation/Unified toolbar" width=fill preview=1200 backdrop="bg-white"
box class="h-[52px] flex-row items-center gap-3 border-b border-zinc-200/80 bg-zinc-50/90 px-4" note="The app's single unified toolbar merging every enabled plugin into one navigation bar: traffic lights, merged views, unified search and settings."
  box class="flex-row items-center gap-2 pr-1" note="The window's own traffic light buttons."
    box class="size-3 rounded-full bg-[#FF5F57]"
    end
    box class="size-3 rounded-full bg-[#FEBC2E]"
    end
    box class="size-3 rounded-full bg-[#28C840]"
    end
  end
  box class="h-4 w-px bg-zinc-200"
  end
  box class="flex-row items-center gap-1 rounded-lg bg-zinc-200/60 p-0.5" note="Merged navigation across all enabled plugins."
    box name=home class="group h-7 flex-row items-center gap-1.5 rounded-md px-2.5 hover:bg-white/60 selected:bg-white selected:shadow-sm"
      icon house class="size-3.5 text-zinc-500 group-selected:text-[#E8553A]"
      text "Home" class="text-[13px] font-medium text-zinc-600 group-selected:text-zinc-900"
    end
    box name=following class="group h-7 flex-row items-center gap-1.5 rounded-md px-2.5 hover:bg-white/60 selected:bg-white selected:shadow-sm" note="Merged followed shows from every plugin that supports following; badge counts shows with new episodes."
      icon tv class="size-3.5 text-zinc-500 group-selected:text-[#E8553A]"
      text "Following" class="text-[13px] font-medium text-zinc-600 group-selected:text-zinc-900"
      text "3" name=following-badge class="rounded-full bg-[#E8553A] px-1.5 text-[10px] font-semibold text-white"
    end
    box name=browse class="group h-7 flex-row items-center gap-1.5 rounded-md px-2.5 hover:bg-white/60 selected:bg-white selected:shadow-sm" note="Merged discovery, rankings and plugin categories across sources."
      icon compass class="size-3.5 text-zinc-500 group-selected:text-[#E8553A]"
      text "Discover" class="text-[13px] font-medium text-zinc-600 group-selected:text-zinc-900"
    end
    box name=open class="group h-7 flex-row items-center gap-1.5 rounded-md px-2.5 hover:bg-white/60 selected:bg-white selected:shadow-sm" note="Open a local video file or paste a direct stream URL."
      icon folder-open class="size-3.5 text-zinc-500 group-selected:text-[#E8553A]"
      text "Open" class="text-[13px] font-medium text-zinc-600 group-selected:text-zinc-900"
    end
  end
  box class="flex-1"
  end
  box name=search class="group h-8 w-[240px] flex-row items-center gap-2 rounded-lg border border-zinc-200/90 bg-white px-2.5 hover:border-zinc-300 selected:border-[#E8553A]/60 selected:ring-2 selected:ring-[#FF6B4A]/15" note="Searches across all enabled plugins at once, or resolves a pasted video link."
    icon search class="size-3.5 text-zinc-400 group-selected:text-[#E8553A]"
    text "Search all sources…" class="flex-1 truncate text-xs text-zinc-400"
    text "⌘K" class="rounded bg-zinc-100 px-1.5 py-0.5 text-[10px] font-medium text-zinc-400"
  end
  box name=settings class="group size-8 items-center justify-center rounded-lg hover:bg-zinc-200/70 selected:bg-zinc-200/80" note="App settings and plugin management; the orange dot shows when a plugin has an update."
    icon settings class="size-4 text-zinc-600 group-selected:text-zinc-900"
    box name=update-dot class="absolute top-1.5 right-1.5 size-2 rounded-full bg-[#E8553A] ring-2 ring-zinc-50"
    end
  end
end
