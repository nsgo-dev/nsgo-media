component name="Player/Top bar" width=fill preview=1200 backdrop="bg-zinc-700"
box class="h-[76px] flex-row items-center gap-3 pr-5 pl-[88px]" note="The title shows in the floating controls; this bar keeps only the way back, 20 points from the top as the controls are from the bottom, its centre on the window buttons' centre and 16 points right of them."
  box name=back class="size-9 items-center justify-center rounded-full border border-white/25 bg-white/10 shadow-lg backdrop-blur-2xl hover:bg-white/20"
    icon chevron-left class="size-[18px] text-white"
  end
  text "Sunrise over an alpine lake, four hours of calm – The ridge catches the sun" name=title class="hidden flex-1 truncate text-sm font-semibold text-white"
end
variant fullscreen class="pl-5"
variant titled class="bg-linear-to-b from-black/70 to-transparent" title.class="flex"
