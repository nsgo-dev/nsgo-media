component name="Sidebar/Item" width=fill preview=216 backdrop="bg-zinc-100/90"
box name=item class="group h-8 flex-row items-center gap-2.5 rounded-md px-2.5 selected:bg-black/[0.07]"
  icon house name=icon class="size-4 text-zinc-500 group-selected:text-[#E8553A]"
  text "Home" name=label class="flex-1 truncate text-[13px] text-zinc-700 group-selected:font-medium group-selected:text-zinc-900"
  text "1" name=badge class="hidden rounded-full bg-[#E8553A] px-1.5 text-[10px] font-semibold text-white"
end
variant selected state=selected
variant badged badge.class="flex"
