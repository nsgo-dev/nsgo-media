component name="Content/Sub-page bar" width=fill preview=1200
box class="h-11 flex-row items-center gap-2 border-b border-zinc-200/70 bg-white/80 px-5" note="Shown on pushed detail pages (video, uploader, plugin settings) below the unified toolbar."
  box name=back class="size-7 items-center justify-center rounded-md hover:bg-zinc-100" note="Returns to the previous page."
    icon chevron-left class="size-[18px] text-zinc-600"
  end
  text "Page Title" name=title class="flex-1 truncate text-[14px] font-semibold text-zinc-900"
  slot actions class="flex-row items-center gap-2"
  end
end
variant root back.class="hidden" title.class="pl-1"
