component name="Player/Danmaku layer" width=fill preview=960 height=540 backdrop="bg-zinc-900"
box name=layer class="pointer-events-none flex-1 overflow-hidden" note="Bilibili-style danmaku overlay: multi-lane scrolling comments from right to left, top-centered and bottom-centered fixed comments, each with a crisp dark drop shadow for legibility over any frame. Display area defaults to the upper half so subtitles stay clear."
  text "The morning light over the ridge is breathtaking" name=s1 class="absolute top-[52px] left-[9%] text-[17px] font-semibold text-white/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "4K HDR looks unreal" name=s2 class="absolute top-[52px] left-[66%] text-[17px] font-semibold text-[#66CCFF]/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "Welcome to the alpine sunrise!" name=top-pin class="absolute top-[82px] right-0 left-0 text-center text-[18px] font-bold text-[#FFE666] drop-shadow-[0_1px_3px_rgba(0,0,0,0.95)]" note="Top-pinned fixed danmaku, centered near the top edge."
  text "Pure calm, no music needed" name=s3 class="absolute top-[116px] left-[22%] text-[17px] font-semibold text-white/90 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "Where is this lake?" name=s4 class="absolute top-[116px] left-[72%] text-[17px] font-semibold text-white/85 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "I play this every morning while coding" name=s5 class="absolute top-[150px] left-[6%] text-[17px] font-semibold text-[#FF85B3]/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "That mist lifting off the water!!" name=s6 class="absolute top-[150px] left-[55%] text-[17px] font-semibold text-white/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "60fps is buttery smooth" name=s7 class="absolute top-[184px] left-[33%] text-[17px] font-semibold text-[#7FFFD4]/95 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "Instant bookmark" name=s8 class="absolute top-[184px] left-[79%] text-[17px] font-semibold text-white/85 drop-shadow-[0_1px_2px_rgba(0,0,0,0.95)]"
  text "Best 4-hour ambient video on here" name=bottom-pin class="absolute right-0 bottom-[112px] left-0 text-center text-[17px] font-semibold text-white/95 drop-shadow-[0_1px_3px_rgba(0,0,0,0.95)]" note="Bottom-pinned fixed danmaku, kept above the floating controls."
end
variant compact s1.class="top-[40px] left-[6%] text-[13px]" s2.class="hidden" top-pin.class="top-[62px] text-[13px]" s3.class="top-[84px] left-[26%] text-[13px]" s4.class="hidden" s5.class="hidden" s6.class="top-[106px] left-[12%] text-[13px]" s7.class="hidden" s8.class="hidden" bottom-pin.class="hidden"
