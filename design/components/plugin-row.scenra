component name="Settings/Plugin" width=fill preview=680
box name=row class="group min-h-[60px] flex-row items-center gap-3 border-b border-zinc-100 px-4 py-2.5 hover:bg-zinc-50"
  box name=tile class="size-9 items-center justify-center rounded-xl bg-linear-to-br from-[#FF8A6B] to-[#E8553A] shadow-sm"
    text "D" name=initial class="text-[15px] font-bold text-white"
  end
  box class="flex-1 gap-0.5"
    box class="flex-row items-center gap-2"
      text "Demo" name=title class="truncate text-[13px] font-semibold text-zinc-900"
      text "1.2.0" name=version class="text-xs text-zinc-400"
    end
    box class="flex-row items-center gap-1"
      icon git-fork name=source-icon class="size-3 text-zinc-400"
      text "example-org/demo-plugin" name=source class="truncate text-xs text-zinc-500"
    end
  end
  box name=update class="hidden h-6 flex-row items-center gap-1 rounded-full bg-[#FF6B4A]/10 px-2.5" note="A newer release of the plugin's repository; pressing it asks to update."
    icon circle-arrow-up class="size-3.5 text-[#E8553A]"
    text "Update to 1.3.0" name=update-label class="text-xs font-semibold text-[#C8442B]"
  end
  box name=problem class="hidden h-6 flex-row items-center gap-1 rounded-full bg-amber-100 px-2.5"
    icon triangle-alert class="size-3.5 text-amber-600"
    text "Needs a newer app" name=problem-label class="text-xs font-semibold text-amber-800"
  end
  use switch name=switch
  icon chevron-right class="size-4 text-zinc-300"
end
variant update update.class="flex"
variant off switch.variant=off tile.class="opacity-50" title.class="text-zinc-500"
variant refused problem.class="flex" switch.class="hidden" tile.class="from-zinc-300 to-zinc-400"
variant last row.class="border-b-0"
