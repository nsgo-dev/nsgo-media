component name="Cards/Part" width=290
box name=row class="group h-14 flex-row items-center gap-3 overflow-hidden rounded-xl border border-zinc-200 bg-white px-3 hover:bg-zinc-50 selected:border-[#E8553A]/50 selected:bg-[#FF6B4A]/[0.06]"
  box class="h-7 min-w-9 items-center justify-center rounded-lg bg-zinc-100 px-1.5 group-selected:bg-[#E8553A]"
    text "P1" name=number class="text-xs font-semibold text-zinc-600 group-selected:text-white"
  end
  box class="flex-1 gap-0.5"
    text "Arrival at the lake" name=title class="truncate text-[13px] font-medium text-zinc-900"
    text "1:24:10" name=duration class="text-xs text-zinc-500 group-selected:text-[#E8553A]"
  end
  icon audio-lines name=playing class="hidden size-4 text-[#E8553A]"
  box name=watched class="absolute right-0 bottom-0 left-0 hidden h-[3px] bg-zinc-100"
    box class="h-full w-full bg-zinc-300"
    end
  end
end
variant current state=selected playing.class="flex"
variant watched watched.class="flex"
