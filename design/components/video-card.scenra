component name="Cards/Video" width=213
box name=card class="group gap-2"
  box class="h-[120px] overflow-hidden rounded-xl bg-zinc-200 shadow-sm"
    image "Video thumbnail" name=image src="assets/thumbs/mountains.jpg" class="size-full"
    use source-badge name=source class="absolute top-1.5 left-1.5" note="Plugin source icon marking where this video comes from in the merged feed."
    text "12:34" name=duration class="absolute right-1.5 bottom-1.5 rounded-md bg-black/70 px-1.5 py-0.5 text-[11px] font-medium text-white"
    box name=watched class="absolute right-0 bottom-0 left-0 hidden h-[3px] bg-white/40" note="How far the viewer got, from the resume positions kept locally; shown once a part of the video was played."
      box class="h-full w-2/5 bg-[#FF6B4A]"
      end
    end
  end
  box class="gap-0.5 px-0.5"
    text "Sunrise over an alpine lake, four hours of calm" name=title class="line-clamp-2 text-[13px] leading-snug font-medium text-zinc-900"
    text "Morning Trails · 3 days ago" name=subtitle class="truncate text-xs text-zinc-500"
  end
end
variant watched watched.class="flex"
variant collection card.note="A collection: its cover, with the number of videos where a video shows its length." duration="24 videos"
