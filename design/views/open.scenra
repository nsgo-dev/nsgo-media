design en in="main#content" name="Main/Open"
box class="flex-1"
  use toolbar variant=root title="Open"
  box class="flex-1 items-center justify-center gap-6 px-10 pb-10" note="Opens a local file or a URL in the player. Loading and errors show in the player, which opens at once."
    box class="w-[520px] items-center gap-4 rounded-3xl border-2 border-dashed border-zinc-200 bg-zinc-50/60 px-10 py-10" note="A file dropped anywhere in the window plays."
      image "NSGo Player's icon" src="assets/app-icon.png" class="size-20"
      box class="items-center gap-1"
        text "Drop a video here" class="text-lg font-semibold text-zinc-900"
        text "Any file FFmpeg reads: MP4, MKV, WebM, MOV and more." class="text-center text-[13px] text-zinc-500"
      end
      use button variant=large icon=folder-open label="Open File…" button.tap="open player#local"
    end
    box class="w-[520px] gap-2"
      text "Or play a URL" class="px-1 text-xs font-semibold text-zinc-500"
      box class="flex-row gap-2"
        box class="h-10 flex-1 flex-row items-center gap-2.5 rounded-xl border border-zinc-200 bg-white px-3.5"
          icon link class="size-4 text-zinc-400"
          text "Paste a URL" class="flex-1 truncate text-sm text-zinc-400"
        end
        use button variant="secondary large text" label="Open"
      end
    end
  end
end

design dragging in="main#content" name="Open · Dropping a file"
box class="flex-1"
  use toolbar variant=root title="Open"
  box class="flex-1 items-center justify-center gap-6 px-10 pb-10"
    box class="w-[520px] items-center gap-4 rounded-3xl border-2 border-dashed border-[#E8553A] bg-[#FF6B4A]/[0.07] px-10 py-10"
      box class="size-20 items-center justify-center rounded-3xl bg-[#E8553A] shadow-lg"
        icon arrow-down-to-line class="size-9 text-white"
      end
      box class="items-center gap-1"
        text "Drop to play" class="text-lg font-semibold text-[#C8442B]"
        text "night-drive-2026-10-03.mkv" class="text-center text-[13px] text-[#C8442B]/70"
      end
      box class="h-10"
      end
    end
    box class="h-[66px] w-[520px]"
    end
  end
end
