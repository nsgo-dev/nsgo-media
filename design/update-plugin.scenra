design update name="Dialogs/Update a plugin" device=desktop width=480 height=420 class="overflow-hidden rounded-2xl bg-white"
box class="flex-1" note="From the plugin's update badge or its page. The release notes are the GitHub release's."
  box class="flex-1 gap-4 px-6 pt-6 pb-5"
    box class="flex-row items-center gap-3.5"
      box class="size-12 items-center justify-center rounded-2xl bg-linear-to-br from-[#FF8A6B] to-[#E8553A] shadow-md"
        text "D" class="text-xl font-bold text-white"
      end
      box class="flex-1 gap-0.5"
        text "Update Demo to 1.3.0?" class="text-[17px] font-bold text-zinc-900"
        text "You have 1.2.0 · Released 2 days ago" class="text-xs text-zinc-500"
      end
    end
    box class="flex-1 gap-1.5 overflow-hidden rounded-xl border border-zinc-200 px-4 py-3"
      text "What's new" class="text-xs font-semibold text-zinc-500"
      text "• Search can filter by uploader and collection.\n• Videos with many parts load faster.\n• Fixes subtitles that started a second late." class="text-[13px] leading-relaxed text-zinc-700"
    end
    box class="flex-row items-center gap-2"
      icon shield-check class="size-4 text-[#16A88E]"
      text "It connects to the same hosts as before." class="text-[13px] text-zinc-600"
    end
  end
  use dialog-actions confirm/label="Update" cancel.tap="close" confirm.tap="open #updating"
end

design new-hosts name="Update a plugin · New hosts" device=desktop width=480 height=440 class="overflow-hidden rounded-2xl bg-white"
box class="flex-1" note="A release that adds hosts asks to approve them; Cancel keeps the version installed."
  box class="flex-1 gap-4 px-6 pt-6 pb-5"
    box class="flex-row items-center gap-3.5"
      box class="size-12 items-center justify-center rounded-2xl bg-linear-to-br from-[#FF8A6B] to-[#E8553A] shadow-md"
        text "D" class="text-xl font-bold text-white"
      end
      box class="flex-1 gap-0.5"
        text "Update Demo to 1.3.0?" class="text-[17px] font-bold text-zinc-900"
        text "You have 1.2.0 · Released 2 days ago" class="text-xs text-zinc-500"
      end
    end
    box class="gap-1.5 overflow-hidden rounded-xl border border-zinc-200 px-4 py-3"
      text "What's new" class="text-xs font-semibold text-zinc-500"
      text "• Search can filter by uploader and collection.\n• Videos with many parts load faster." class="text-[13px] leading-relaxed text-zinc-700"
    end
    box class="gap-2.5 rounded-xl border border-amber-200 bg-amber-50/70 px-4 py-3.5"
      box class="flex-row items-center gap-2"
        icon shield-alert class="size-4 text-amber-600"
        text "It can now also connect to:" class="text-[13px] font-semibold text-zinc-900"
      end
      box class="flex-row flex-wrap gap-1.5"
        use host-chip variant=new host="cdn.example.org"
        use host-chip host="api.example.com"
        use host-chip host="img.example.com"
        use host-chip host="media.example.net"
      end
    end
  end
  use dialog-actions confirm/label="Approve and Update" cancel.tap="close" confirm.tap="open #updating"
end

design updating name="Update a plugin · Updating" device=desktop width=480 height=420 class="overflow-hidden rounded-2xl bg-white"
box class="flex-1"
  box class="flex-1 gap-4 px-6 pt-6 pb-5"
    box class="flex-row items-center gap-3.5"
      box class="size-12 items-center justify-center rounded-2xl bg-linear-to-br from-[#FF8A6B] to-[#E8553A] shadow-md"
        text "D" class="text-xl font-bold text-white"
      end
      box class="flex-1 gap-0.5"
        text "Updating Demo to 1.3.0…" class="text-[17px] font-bold text-zinc-900"
        text "You have 1.2.0" class="text-xs text-zinc-500"
      end
    end
    box class="flex-1 justify-center gap-2" note="Its settings, data and sign-in stay. Its pages open again with the new version; a video playing keeps playing."
      box class="h-1.5 overflow-hidden rounded-full bg-zinc-100"
        box class="h-full w-2/5 rounded-full bg-[#E8553A]"
        end
      end
      text "Downloading 1.3.0…" class="text-xs text-zinc-500"
    end
  end
  use dialog-actions confirm/label="Update" confirm.variant="text busy" cancel.class="opacity-40"
end

design failed name="Update a plugin · Failed" device=desktop width=480 height=420 class="overflow-hidden rounded-2xl bg-white"
box class="flex-1"
  box class="flex-1 gap-4 px-6 pt-6 pb-5"
    box class="flex-row items-center gap-3.5"
      box class="size-12 items-center justify-center rounded-2xl bg-linear-to-br from-[#FF8A6B] to-[#E8553A] shadow-md"
        text "D" class="text-xl font-bold text-white"
      end
      box class="flex-1 gap-0.5"
        text "Demo could not be updated" class="text-[17px] font-bold text-zinc-900"
        text "1.2.0 stays installed" class="text-xs text-zinc-500"
      end
    end
    box class="flex-row gap-2.5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3.5"
      icon circle-alert class="size-4 text-rose-500"
      text "The release's plugin zip is not a valid plugin: plugin.yaml has an unknown field “theme”." class="flex-1 text-[13px] leading-relaxed text-rose-800"
    end
  end
  use dialog-actions confirm/label="Try Again" cancel/label="Close" cancel.tap="close"
end
