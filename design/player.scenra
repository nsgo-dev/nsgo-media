design playing name="Player/Standalone window" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" note="Opens in its own compact 16:9 borderless window with no macOS traffic lights. Drag anywhere on the video to move, press Pin in the top-right to keep always on top. The top bar and slim controls show while the pointer is over the window and fade out in 150 ms, with the pointer, as soon as it leaves the window or rests for 1.5 seconds; moving it again shows them at once. They stay while the pointer is over them, a menu is open or nothing has played yet. Space plays or pauses, ←/→ seek, ↑/↓ change volume, D toggles danmaku, P toggles always-on-top, F toggles full screen and Esc leaves full screen or closes."
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use danmaku-layer class="absolute inset-0"
  use player-top class="absolute top-0 right-0 left-0" close.tap="close" pin.tap="open #pinned"
  box class="absolute bottom-[80px] left-[200px] flex-row items-center gap-1 rounded-full border border-white/25 bg-black/40 py-1 pr-1 pl-3 shadow-lg backdrop-blur-2xl" note="Offered for a few seconds when the part was left partway; pressing it seeks there."
    icon rotate-ccw class="size-3.5 text-white"
    text "Resume at 1:31:05" class="px-1 text-xs font-medium text-white"
    box class="size-6 items-center justify-center rounded-full hover:bg-white/15"
      icon x class="size-3 text-white/80"
    end
  end
  box class="absolute right-0 bottom-3 left-0 items-center"
    use player-controls class="w-[560px]" danmaku.tap="open #danmaku" quality.tap="open #quality" subtitles.tap="open #tracks" parts.tap="open #parts" fullscreen.tap="open #fullscreen" speed.tap="open #speed"
  end
end

design idle name="Player · Controls hidden" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" tap="open #playing" note="The pointer left the window or rested for 1.5 seconds: the top bar, controls and pointer fade out in 150 ms, leaving only the picture and danmaku. Moving the pointer over the window shows them again at once."
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use danmaku-layer class="absolute inset-0"
end

design pinned name="Player · Pinned on top" device=desktop width=560 height=315 class="overflow-hidden rounded-2xl border border-[#FF6B4A]/50 bg-black shadow-2xl"
box class="flex-1" note="Compact always-on-top mode: stays above other apps while you work. No traffic lights, active Pinned badge in top-right, and streamlined mini controls, which show and hide with the pointer as in the standalone window."
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use danmaku-layer variant=compact class="absolute inset-0"
  use player-top variant=pinned class="absolute top-0 right-0 left-0" title="The ridge catches the sun" close.tap="close" pin.tap="open #playing"
  box class="absolute right-0 bottom-2.5 left-0 items-center"
    use player-controls variant=mini class="w-[360px]" danmaku.tap="open #danmaku" fullscreen.tap="open #fullscreen"
  end
end

design danmaku name="Player · Danmaku settings" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" note="Bilibili-style danmaku controls: master toggle, type filters (scroll, top, bottom, color), opacity, display area, font size and scrolling speed."
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use danmaku-layer class="absolute inset-0"
  use player-top class="absolute top-0 right-0 left-0" close.tap="close" pin.tap="open #pinned"
  box class="absolute right-0 bottom-3 left-0 items-center"
    use player-controls class="w-[560px]" danmaku.class="bg-white/25"
  end
  box class="absolute right-[288px] bottom-[78px] w-[308px] gap-3 rounded-[20px] border border-white/20 bg-zinc-900/70 p-3.5 shadow-2xl backdrop-blur-2xl backdrop-saturate-150"
    box class="flex-row items-center justify-between"
      box class="flex-row items-center gap-2"
        icon message-square-text class="size-4 text-[#66CCFF]"
        text "Danmaku" class="text-[13px] font-semibold text-white"
      end
      box class="h-5 w-9 items-end justify-center rounded-full bg-[#E8553A] p-0.5"
        box class="size-4 rounded-full bg-white shadow-sm"
        end
      end
    end
    box class="gap-1.5"
      text "Display types" class="text-[11px] font-medium text-white/50"
      box class="flex-row gap-1.5"
        box class="flex-1 items-center gap-1 rounded-xl bg-white/15 py-2"
          icon move-horizontal class="size-3.5 text-[#66CCFF]"
          text "Scroll" class="text-[11px] font-medium text-white"
        end
        box class="flex-1 items-center gap-1 rounded-xl bg-white/15 py-2"
          icon arrow-up-to-line class="size-3.5 text-[#FFE666]"
          text "Top" class="text-[11px] font-medium text-white"
        end
        box class="flex-1 items-center gap-1 rounded-xl bg-white/15 py-2"
          icon arrow-down-to-line class="size-3.5 text-white"
          text "Bottom" class="text-[11px] font-medium text-white"
        end
        box class="flex-1 items-center gap-1 rounded-xl bg-white/15 py-2"
          icon palette class="size-3.5 text-[#FF85B3]"
          text "Color" class="text-[11px] font-medium text-white"
        end
      end
    end
    box class="gap-1.5"
      box class="flex-row items-center justify-between"
        text "Opacity" class="text-[11px] font-medium text-white/50"
        text "85%" class="text-[11px] font-semibold text-white/90"
      end
      box class="h-3.5 justify-center"
        box class="h-1 rounded-full bg-white/20"
          box class="h-full w-[85%] rounded-full bg-[#66CCFF]"
          end
        end
        box class="absolute left-[85%] -ml-1.5 size-3 rounded-full bg-white shadow-md"
        end
      end
    end
    box class="gap-1.5"
      text "Display area" class="text-[11px] font-medium text-white/50"
      box class="flex-row gap-1 rounded-xl bg-white/10 p-0.5"
        box class="flex-1 items-center rounded-lg py-1"
          text "1/4" class="text-[11px] font-medium text-white/70"
        end
        box class="flex-1 items-center rounded-lg bg-white/20 py-1"
          text "1/2" class="text-[11px] font-semibold text-white"
        end
        box class="flex-1 items-center rounded-lg py-1"
          text "3/4" class="text-[11px] font-medium text-white/70"
        end
        box class="flex-1 items-center rounded-lg py-1"
          text "Full" class="text-[11px] font-medium text-white/70"
        end
      end
    end
    box class="flex-row gap-2"
      box class="flex-1 gap-1.5"
        text "Font size" class="text-[11px] font-medium text-white/50"
        box class="flex-row gap-0.5 rounded-xl bg-white/10 p-0.5"
          box class="flex-1 items-center rounded-lg py-1"
            text "S" class="text-[11px] font-medium text-white/70"
          end
          box class="flex-1 items-center rounded-lg bg-white/20 py-1"
            text "M" class="text-[11px] font-semibold text-white"
          end
          box class="flex-1 items-center rounded-lg py-1"
            text "L" class="text-[11px] font-medium text-white/70"
          end
        end
      end
      box class="flex-1 gap-1.5"
        text "Speed" class="text-[11px] font-medium text-white/50"
        box class="flex-row gap-0.5 rounded-xl bg-white/10 p-0.5"
          box class="flex-1 items-center rounded-lg py-1"
            text "Slow" class="text-[11px] font-medium text-white/70"
          end
          box class="flex-1 items-center rounded-lg bg-white/20 py-1"
            text "1×" class="text-[11px] font-semibold text-white"
          end
          box class="flex-1 items-center rounded-lg py-1"
            text "Fast" class="text-[11px] font-medium text-white/70"
          end
        end
      end
    end
  end
end

