  end
end

design loading name="Player · Loading" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" note="Opening the source, buffering, or calling stream for another quality or part: the last picture stays dimmed, if any."
  image "Alpine lake at sunrise, dimmed" src="assets/thumbs/mountains.jpg" class="absolute inset-0 opacity-40"
  use player-top class="absolute top-0 right-0 left-0"
  box class="absolute inset-0 items-center justify-center"
    box class="size-14 items-center justify-center rounded-full border border-white/25 bg-white/10 shadow-2xl backdrop-blur-2xl"
      icon loader-circle class="size-6 text-white"
    end
  end
  box class="absolute right-0 bottom-3 left-0 items-center"
    use player-controls class="w-[560px]" play-icon=play
  end
end

design error name="Player · Cannot play" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" note="The source failed to open or play in the standalone player window."
  use player-top variant=titled class="absolute top-0 right-0 left-0" title="Driving through the city in the rain" close.tap="close"
  box class="flex-1 items-center justify-center gap-3 px-10"
    box class="size-12 items-center justify-center rounded-2xl bg-white/10"
      icon circle-alert class="size-5 text-rose-400"
    end
    text "This file or URL cannot be played." class="text-center text-sm font-semibold text-white"
    text "Server returned 403 Forbidden" class="max-w-[440px] text-center text-xs text-white/50" note="The player's own error, for the curious."
    box class="mt-2 flex-row gap-2"
      box class="h-8 items-center justify-center rounded-lg bg-white/10 px-3.5" tap="close"
        text "Close" class="text-xs font-medium text-white"
      end
      box class="h-8 items-center justify-center rounded-lg bg-white px-3.5"
        text "Try Again" class="text-xs font-medium text-zinc-900"
      end
    end
  end
end

design fullscreen name="Player · Full screen" device=desktop width=1512 height=982 class="rounded-none border-0 bg-black"
box class="flex-1" note="Full screen: no window buttons; danmaku scales cleanly and the slim controls sit centred near the bottom; they and the pointer hide after 1.5 seconds of stillness."
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use danmaku-layer class="absolute inset-0"
  use player-top variant=fullscreen class="absolute top-0 right-0 left-0" close.tap="close"
  box class="absolute right-0 bottom-7 left-0 items-center"
    use player-controls variant=fullscreen class="w-[640px]" danmaku.tap="open #danmaku" fullscreen.tap="close"
  end
end

design local name="Player · Local file" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1" note="A local file or a URL from the Open page: compact borderless standalone window with pin support, no parts, qualities or danmaku."
  image "A city street at night, the video playing" src="assets/thumbs/city.jpg" class="absolute inset-0"
  use player-top variant=local class="absolute top-0 right-0 left-0" title="night-drive-2026-10-03.mkv" close.tap="close" pin.tap="open #pinned"
  box class="absolute right-0 bottom-3 left-0 items-center"
    use player-controls variant=local class="w-[560px]" elapsed="12:48" duration="1:12:05"
  end
end
