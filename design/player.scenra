design tracks name="Player · Subtitles and audio" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1"
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use player-top class="absolute top-0 right-0 left-0"
  text "The mist lifts as the sun reaches the water." class="absolute right-0 bottom-[84px] left-0 text-center text-[19px] font-medium text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.95)]" note="Subtitles, over the picture and above the floating controls while they show."
  box class="absolute right-0 bottom-3 left-0 items-center"
    use player-controls class="w-[560px]" subtitles.class="bg-white/25"
  end
  box class="absolute right-[134px] bottom-[78px] w-[340px] flex-row gap-1 rounded-[18px] border border-white/20 bg-zinc-900/65 p-1.5 shadow-2xl backdrop-blur-2xl backdrop-saturate-150" note="The source's subtitle tracks, its own or the plugin's, and audio tracks, each by its title or else its number."
    box class="flex-1 gap-0.5"
      text "Subtitles" class="px-2.5 pt-1 pb-1 text-[11px] font-semibold text-white/50"
      box class="h-7 flex-row items-center rounded-xl px-2.5"
        text "Off" class="flex-1 text-xs text-white/90"
      end
      box class="h-7 flex-row items-center rounded-xl bg-white/15 px-2.5"
        text "English" class="flex-1 truncate text-xs font-medium text-white"
        icon check class="size-3.5 text-white"
      end
      box class="h-7 flex-row items-center rounded-xl px-2.5"
        text "简体中文" class="flex-1 truncate text-xs text-white/90"
      end
    end
    box class="w-px bg-white/10"
    end
    box class="flex-1 gap-0.5"
      text "Audio" class="px-2.5 pt-1 pb-1 text-[11px] font-semibold text-white/50"
      box class="h-7 flex-row items-center rounded-xl bg-white/15 px-2.5"
        text "Natural sound" class="flex-1 truncate text-xs font-medium text-white"
        icon check class="size-3.5 text-white"
      end
      box class="h-7 flex-row items-center rounded-xl px-2.5"
        text "Track 2" class="flex-1 truncate text-xs text-white/90"
      end
    end
  end
end

design parts name="Player · Parts" device=desktop width=960 height=540 class="overflow-hidden rounded-2xl border border-white/15 bg-black shadow-2xl"
box class="flex-1"
  image "Alpine lake at sunrise, the video playing" src="assets/thumbs/mountains.jpg" class="absolute inset-0"
  use player-top class="absolute top-0 right-0 left-0"
