      icon audio-lines class="size-3.5 text-white"
    end
    box class="flex-row items-center gap-2.5 rounded-xl px-2.5 py-2"
      text "P3" class="w-5 text-[11px] font-semibold text-white/50"
      box class="flex-1 gap-0.5"
        text "Mist off the water" class="truncate text-xs text-white/90"
        text "51:36" class="text-[11px] text-white/40"
