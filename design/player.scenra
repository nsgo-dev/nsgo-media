    end
    box class="flex-row items-center gap-2.5 rounded-xl bg-white/15 px-2.5 py-2"
      text "P2" class="w-5 text-[11px] font-semibold text-white"
      box class="flex-1 gap-0.5"
        text "The ridge catches the sun" class="truncate text-xs font-medium text-white"
        text "1:46:32 · Playing" class="text-[11px] text-white/60"
