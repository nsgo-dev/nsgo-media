    use player-controls class="w-[560px]" parts.class="bg-white/25"
  end
  box class="absolute top-14 right-3.5 bottom-[78px] w-[272px] gap-1 rounded-[20px] border border-white/20 bg-zinc-900/65 p-2 shadow-2xl backdrop-blur-2xl backdrop-saturate-150" note="The video's parts beside the picture; choosing one plays it. At a part's end the next follows."
    text "Parts · 3" class="px-2.5 pt-1 pb-1.5 text-xs font-semibold text-white"
    box class="flex-row items-center gap-2.5 rounded-xl px-2.5 py-2"
      text "P1" class="w-5 text-[11px] font-semibold text-white/50"
