design name="Main window" device=desktop class="overflow-hidden rounded-xl bg-white"
box class="flex-1"
  use app-toolbar home.tap="open home" following.tap="open following" browse.tap="open browse" open.tap="open open" search.tap="open search" settings.tap="open settings"
  box class="flex-1 bg-white" outlet=content note="The page opened from the unified toolbar, or a detail page opened from it. Back returns through pushed pages; choosing a toolbar tab starts over."
    use home class="flex-1"
  end
end
