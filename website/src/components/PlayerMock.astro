---
// The hero's picture of the split NSGo Media makes: the core draws the
// frame, the app draws everything above it. The scene is drawn in CSS, not
// taken from any video.
interface Props {
	t: { label: string; core: string; app: string; cue: string };
}
const { t } = Astro.props;
---

<figure class="mock" role="img" aria-label={t.label}>
	<div class="mock-window">
		<div class="mock-bar" aria-hidden="true"><span></span><span></span><span></span></div>
		<div class="mock-picture">
			<div class="scene" aria-hidden="true">
				<span class="sun"></span>
				<span class="hill far"></span>
				<span class="hill near"></span>
			</div>
			<span class="tag core">{t.core}</span>
			<div class="app-layer">
				<span class="tag app">{t.app}</span>
				<p class="cue">{t.cue}</p>
				<div class="controls" aria-hidden="true">
					<span class="play">
						<svg viewBox="0 0 24 24" width="14" height="14"><path d="M7 4.5v15l12-7.5z" fill="currentColor"></path></svg>
					</span>
					<span class="track"><span class="buffered"></span><span class="played"></span></span>
					<span class="volume">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
					</span>
				</div>
			</div>
		</div>
	</div>
</figure>

<style>
	.mock {
		width: min(100%, 36rem);
		margin: 0 auto;
	}
	.mock-window {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background-color: var(--surface);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 30px 60px -30px rgb(0 0 0 / 0.45);
	}
	.mock-bar {
		display: flex;
		gap: 0.375rem;
		padding: 0.625rem 0.75rem;
		border-bottom: 1px solid var(--border);
	}
	.mock-bar span {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background-color: var(--border-strong);
	}
	.mock-picture {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: #0b1220;
	}

	/* The frame: an evening sky over two hills, drifting slowly. */
	.scene {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, #1e3a8a 0%, #6d28d9 45%, #f97316 88%, #fdba74 100%);
	}
	.sun {
		position: absolute;
		left: 58%;
		top: 46%;
		width: 22%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, #fff7ed 0 35%, #fdba74 60%, rgb(253 186 116 / 0) 72%);
		animation: sun 14s ease-in-out infinite alternate;
	}
	.hill {
		position: absolute;
		left: -20%;
		right: -20%;
		border-radius: 50% 50% 0 0;
	}
	.hill.far {
		bottom: -38%;
		height: 72%;
		background: linear-gradient(180deg, #4c1d95, #1e1b4b);
		transform: translateX(-12%);
		animation: drift 18s ease-in-out infinite alternate;
	}
	.hill.near {
		bottom: -52%;
		height: 80%;
		background: linear-gradient(180deg, #1e1b4b, #0b1220);
		transform: translateX(16%);
		animation: drift 12s ease-in-out infinite alternate-reverse;
	}
	@keyframes sun {
		to {
			transform: translateY(-14%);
		}
	}
	@keyframes drift {
		to {
			translate: 4% 0;
		}
	}

	.tag {
		position: absolute;
		z-index: 2;
		padding: 0.1875rem 0.5rem;
		border-radius: 999px;
		font-size: 0.6875rem;
		font-weight: 650;
		letter-spacing: 0.01em;
		line-height: 1.3;
		white-space: nowrap;
	}
	.tag.core {
		top: 0.75rem;
		left: 0.75rem;
		background-color: rgb(255 255 255 / 0.16);
		color: #fff;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	/* What the app draws: subtitles and controls, outlined in the accent. */
	.app-layer {
		position: absolute;
		inset: auto 0.75rem 0.75rem;
		display: grid;
		justify-items: center;
		gap: 0.625rem;
		padding: 1.5rem 0.625rem 0.625rem;
		border: 1.5px dashed rgb(140 196 255 / 0.85);
		border-radius: 0.875rem;
	}
	.tag.app {
		top: 0;
		right: 0.75rem;
		transform: translateY(-50%);
		background-color: #4da3ff;
		color: #0a0b0d;
	}
	.cue {
		margin: 0;
		padding: 0.125rem 0.5rem;
		border-radius: 0.375rem;
		background-color: rgb(0 0 0 / 0.5);
		color: #fff;
		font-size: clamp(0.75rem, 0.6rem + 0.5vw, 0.9375rem);
		line-height: 1.4;
		text-align: center;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		width: 100%;
		padding: 0.375rem 0.625rem 0.375rem 0.375rem;
		border-radius: 999px;
		background-color: rgb(10 11 13 / 0.55);
		color: #fff;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}
	.play {
		display: grid;
		flex: none;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		background-color: #fff;
		color: #0a0b0d;
	}
	.play svg {
		margin-left: 2px;
	}
	.track {
		position: relative;
		flex: 1;
		height: 0.25rem;
		overflow: hidden;
		border-radius: 999px;
		background-color: rgb(255 255 255 / 0.2);
	}
	.track span {
		position: absolute;
		inset: 0 auto 0 0;
		border-radius: inherit;
	}
	.buffered {
		width: 72%;
		background-color: rgb(255 255 255 / 0.35);
	}
	.played {
		width: 38%;
		background-color: #4da3ff;
		animation: play 16s linear infinite;
	}
	@keyframes play {
		from {
			width: 8%;
		}
		to {
			width: 70%;
		}
	}
	.volume {
		display: grid;
		flex: none;
		place-items: center;
		opacity: 0.85;
	}

	@media (prefers-reduced-motion: reduce) {
		.sun,
		.hill,
		.played {
			animation: none;
		}
	}
</style>
