---
// The home page: what the core does for an app, how an app uses it and
// where it runs. The API in depth is in the docs.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Icon } from '@astrojs/starlight/components';
import KIcon from './KIcon.astro';
import PlayerMock from './PlayerMock.astro';
import AsciiField from './AsciiField.astro';
import type { IconName } from '../icons';
import '../styles/home.css';
import { copy, docsHome, usage } from '../copy';
import { project, type Lang } from '../site';
import { url } from '../url';
import nsgoLogo from '../assets/nsgo.svg?url';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const nsgo = { site: 'https://nsgo.dev', repo: 'https://github.com/nsgo-dev/nsgo' };

// Splits a heading after each Chinese comma, so each part wraps as a whole.
const phrases = (text: string) => text.split(/(?<=，)/);

// Each highlight's icon in a color of its own.
const featureColors = ['#3b82f6', '#8b5cf6', '#22a45d', '#f59e0b', '#0ea5e9', '#ec4899'];
const usageColors = ['#6366f1', '#14b8a6', '#d97706'];
const platformIcons: Record<string, IconName> = { macos: 'laptop', windows: 'app-window', linux: 'terminal', ios: 'smartphone' };
const platformColors: Record<string, string> = { macos: '#3b82f6', windows: '#0ea5e9', linux: '#d97706', ios: '#8b5cf6' };
---

<StarlightPage
	frontmatter={{ title: t.title, description: t.description, template: 'splash', home: true, tableOfContents: false, pagefind: false }}
	hasSidebar={false}
	lang={t.htmlLang}
>
	<div class="home">
		<section class="hero">
			<div class="container hero-row">
				<div class="hero-copy">
					<p class="status-pill rise" style="--i: 0"><span class="dot" aria-hidden="true"></span>{t.status}</p>
					<h1 id="_top" class="headline rise" style="--i: 0">
						<span>{t.headline[0]}</span>
						<span class="accent">{t.headline[1]}</span>
					</h1>
					<p class="lead rise" style="--i: 1">{t.lead}</p>
					<div class="cta rise" style="--i: 2">
						<a class="button primary" href={url(docsHome[lang])}>
							{t.cta.start}
							<Icon name="right-arrow" size="1rem" />
						</a>
						<a class="button secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
							<Icon name="github" size="1.05rem" />
							GitHub
							<Icon name="external" size="0.85rem" class="external" />
						</a>
					</div>
					<ul class="hero-meta rise" style="--i: 3">
						{t.meta.map((m) => <li>{m}</li>)}
					</ul>
				</div>
				<div class="hero-stage rise" style="--i: 1">
					<PlayerMock t={t.mock} />
				</div>
			</div>
		</section>

		<section class="section" id="features">
			<div class="container">
				<header class="section-head">
					<p class="eyebrow">{t.features.eyebrow}</p>
					<h2>{phrases(t.features.title).map((p) => <span class="phrase">{p}</span>)}</h2>
				</header>
				<ul class="features">
					{
						t.features.items.map((f, i) => (
							<li class="feature" data-kubai-trigger>
								<span class="feature-icon">
									<KIcon name={f.icon} size={28} color={featureColors[i]} />
								</span>
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="section">
			<div class="container usage-row">
				<div class="usage-copy">
					<header class="section-head left">
						<p class="eyebrow">{t.usage.eyebrow}</p>
						<h2>{phrases(t.usage.title).map((p) => <span class="phrase">{p}</span>)}</h2>
						<p>{t.usage.text}</p>
					</header>
					<ul class="points">
						{
							t.usage.items.map((f, i) => (
								<li class="point" data-kubai-trigger>
									<span class="point-icon">
										<KIcon name={f.icon} size={22} color={usageColors[i]} />
									</span>
									<div>
										<h3>{f.title}</h3>
										<p>{f.text}</p>
									</div>
								</li>
							))
						}
					</ul>
				</div>
				<div class="usage-code">
					<Code code={usage} lang="go" />
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<header class="section-head">
					<p class="eyebrow">{t.platforms.eyebrow}</p>
					<h2>{phrases(t.platforms.title).map((p) => <span class="phrase">{p}</span>)}</h2>
				</header>
				<ul class="platforms">
					{
						t.platforms.items.map((p) => (
							<li class="platform" data-kubai-trigger>
								<span class="platform-icon">
									<KIcon name={platformIcons[p.id]} size={30} color={platformColors[p.id]} />
								</span>
								<div>
									<h3>{p.name}</h3>
									<p>{p.text}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="section end">
			<div class="container">
				<div class="end-card">
					<AsciiField />
					<img class="end-logo" src={nsgoLogo} alt="" width="64" height="64" />
					<h2>{phrases(t.end.title).map((p) => <span class="phrase">{p}</span>)}</h2>
					<p>{t.end.text}</p>
					<div class="cta center">
						<a class="button primary" href={nsgo.site} target="_blank" rel="noopener noreferrer">
							{t.end.site}
							<Icon name="external" size="0.9rem" />
						</a>
						<a class="button secondary" href={nsgo.repo} target="_blank" rel="noopener noreferrer">
							<Icon name="github" size="1rem" />
							GitHub
							<Icon name="external" size="0.85rem" class="external" />
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</StarlightPage>
